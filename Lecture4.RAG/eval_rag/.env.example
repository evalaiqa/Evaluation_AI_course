# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env

# --- RAG-система, которую оцениваем ---
# Адрес чат-API RAG-системы и ключ доступа (заголовок X-API-Key).
# Локальный запуск (docker-compose): http://localhost:8002/api/v1/chat/
RAG_ENDPOINT_URL=http://5.11.83.110:8002/api/v1/chat/
RAG_API_KEY=your-rag-api-key

# --- Прокси для LLM-судьи и эмбеддингов (OpenAI-совместимый) ---
# Через прокси метрики обращаются к LLM: подставьте свой ключ
PROXY_BASE_URL=http://5.11.83.110:8000
PROXY_API_KEY=sk-proxy-your-key

# --- Модель-судья, через которую считаются метрики ---
MODEL=gpt-4o-mini
