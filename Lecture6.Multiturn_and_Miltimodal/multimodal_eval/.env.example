# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env

# --- Прокси для LLM-судьи (OpenAI-совместимый) ---
# Через прокси мультимодальные метрики обращаются к MLLM: подставьте свой ключ
PROXY_BASE_URL=http://5.11.83.110:8000
PROXY_API_KEY=sk-proxy-your-key

# --- Модель-судья, через которую считаются метрики (должна поддерживать vision) ---
MODEL=gpt-4o-mini
